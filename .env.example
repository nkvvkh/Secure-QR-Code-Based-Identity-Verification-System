# Copy this file to ".env" and replace the values. NEVER commit ".env" to Git.

# Signs Flask session cookies (>= 32 characters)
FLASK_SECRET_KEY=replace-with-64-hex-characters

# Secret key used for HMAC-SHA256 signatures inside QR codes (>= 32 characters).
# If this key changes, every QR code that was issued becomes INVALID.
QR_HMAC_KEY=replace-with-another-64-hex-characters

# Demo admin account, created automatically the first time the database is initialised
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@12345

# Set to true ONLY when the site is served over HTTPS
SESSION_COOKIE_SECURE=false

# 1 = Flask debug mode (development only), 0 = off
FLASK_DEBUG=0
